SCALEKIT_ENVIRONMENT_URL=
SCALEKIT_CLIENT_ID=
SCALEKIT_CLIENT_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:4000
MONGODB_URL=
MONGODB_DB_NAME=
NODE_ENV=development
GEMINI_API_KEY=

# Archestra integration
USE_ARCHESTRA_CHAT=false
ARCHESTRA_BASE_URL=http://localhost:9000
ARCHESTRA_API_KEY=
ARCHESTRA_ADMIN_API_KEY=
ARCHESTRA_SESSION_COOKIE=
ARCHESTRA_AGENT_ID=
ARCHESTRA_CHAT_MODEL=gemini-2.5-flash
ARCHESTRA_AGENT_NAME=botweave-support-agent
ARCHESTRA_AGENT_MODEL=
ARCHESTRA_LLM_API_KEY_ID=
ARCHESTRA_TEAM_ID=
ARCHESTRA_KNOWLEDGE_MCP_URL=http://host.docker.internal:4101/mcp
ARCHESTRA_SUPPORT_MCP_URL=http://host.docker.internal:4102/mcp
ARCHESTRA_KNOWLEDGE_CATALOG_NAME=botweave-knowledge-mcp
ARCHESTRA_SUPPORT_CATALOG_NAME=botweave-support-mcp
ARCHESTRA_KNOWLEDGE_SERVER_NAME=botweave-knowledge-mcp-instance
ARCHESTRA_SUPPORT_SERVER_NAME=botweave-support-mcp-instance
ARCHESTRA_INCLUDE_GITHUB_TOOLS=true
ARCHESTRA_GITHUB_MCP_MATCH=github
ARCHESTRA_GITHUB_TOOL_NAMES=
ARCHESTRA_SETUP_REINSTALL=false
ARCHESTRA_SETUP_TIMEOUT_MS=120000

# Optional comma-separated allowlist for widget origins.
# If empty, CORS defaults to '*' for compatibility.
BOTWEAVE_ALLOWED_EMBED_ORIGINS=

# MCP server ports
KNOWLEDGE_MCP_PORT=4101
SUPPORT_MCP_PORT=4102
